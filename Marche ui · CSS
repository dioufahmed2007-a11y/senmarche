/* ═══════════════════════════════════════════════════════════════
   SEN·MARCHÉ — marche-ui.css
   Composants partagés des pages collection / archives / collections.
   À charger après marche.css. Aucune couleur en dur : tout vient des tokens.
   ═══════════════════════════════════════════════════════════════ */
body.se-page{padding-top:56px;font-family:var(--m-body);overflow-x:clip;max-width:100%;-webkit-tap-highlight-color:transparent}
body.se-page img,body.se-page svg{max-width:100%}
.m-wrap{position:relative;max-width:1240px;margin:0 auto;padding:0 var(--gut)}
.chap{padding:clamp(2.6rem,6vw,4.6rem) 0 0}
.disp{font-family:var(--m-display);font-weight:800;font-variation-settings:"wdth" 75;text-transform:uppercase;letter-spacing:-.02em;line-height:.88}
.eyebrow{display:inline-flex;align-items:center;gap:.55rem;font:700 .88rem/1 var(--m-body);color:var(--eb,var(--m-acc-vert));margin-bottom:.9rem}
.eyebrow::before{content:'';width:.55em;height:.55em;background:currentColor;border-radius:50%}
.btn-s{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.95rem 1.6rem;min-height:48px;border-radius:12px;font:700 .92rem/1 var(--m-body);text-decoration:none;cursor:pointer;border:2px solid transparent;background:var(--bgc,var(--m-safran));color:var(--tc,var(--m-on-safran));transition:transform .2s,box-shadow .2s,filter .2s}
.btn-s:hover{transform:translateY(-2px);box-shadow:0 12px 24px -10px color-mix(in srgb,var(--bgc,var(--m-safran)) 60%,transparent)}
.btn-s.btn-wa{--bgc:var(--m-wa);--tc:var(--m-on-nuit)}
.btn-s.btn-dark{--bgc:var(--ink);--tc:var(--bg)}
.btn-s[disabled],.btn-s.is-off{opacity:.45;pointer-events:none}

/* titre de chapitre (même style que Mode) */
.sh{display:grid;grid-template-columns:auto 1fr auto;align-items:end;gap:.4rem 1.1rem;margin-bottom:1.6rem;padding-bottom:1rem;border-bottom:1px solid var(--border)}
.sh-n{font:800 clamp(2.6rem,7vw,4.6rem)/.8 var(--m-display);color:transparent;-webkit-text-stroke:2px var(--m-safran)}
.sh h2{font:800 clamp(2rem,5.2vw,3.3rem)/1.02 var(--m-display);font-variation-settings:"wdth" 92;letter-spacing:-.03em;color:var(--ink);margin:0;text-wrap:balance}
.sh h2 i,.t-big i,.next h2 i,.look-title i{font-family:var(--m-serif);font-style:italic;font-weight:500;font-variation-settings:normal;letter-spacing:-.02em;color:var(--m-acc-bissap)}
.sh-meta{font:600 .85rem/1.2 var(--m-body);color:var(--stone);text-align:right}
@media(max-width:640px){.sh{grid-template-columns:auto 1fr}.sh-meta{grid-column:1/-1;text-align:left;order:3}.sh-n{-webkit-text-stroke-width:1.5px}}
.t-big{font:800 clamp(2.4rem,7vw,4.6rem)/.98 var(--m-display);font-variation-settings:"wdth" 90;letter-spacing:-.035em;color:var(--ink);margin:0 0 1rem}

.noimg{background:var(--m-g-vert)!important;position:relative}
.noimg::after{content:'Sen·Marché';position:absolute;inset:0;display:grid;place-items:center;font:800 1.3rem/1 var(--m-display);color:color-mix(in srgb,var(--m-on-vert) 70%,transparent);pointer-events:none}

/* ═════════ HERO ═════════ */
.chero{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:min(72svh,640px);padding:clamp(2rem,5vw,3.5rem) var(--gut);color:var(--m-on-nuit);background:var(--m-nuit);overflow:hidden}
.chero::before{content:'';position:absolute;inset:0;z-index:-4;background:radial-gradient(55% 60% at 88% 14%,color-mix(in srgb,var(--m-safran) 30%,transparent),transparent 65%),radial-gradient(50% 55% at 0% 100%,color-mix(in srgb,var(--m-bissap) 36%,transparent),transparent 65%),var(--m-g-vert)}
.chero-bg{position:absolute;inset:0;z-index:-3;background-size:cover;background-position:center;opacity:0;transition:opacity .8s;filter:var(--hero-filter,grayscale(.25) contrast(1.05))}
.chero-bg.on{opacity:1}
.chero-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(to top,color-mix(in srgb,var(--m-nuit) 88%,transparent) 4%,color-mix(in srgb,var(--m-nuit) 35%,transparent) 55%,color-mix(in srgb,var(--m-nuit) 18%,transparent))}
.snow{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.snow i{position:absolute;top:-10px;background:var(--m-on-nuit);border-radius:50%;animation:fall linear infinite}
@keyframes fall{0%{transform:translateY(-10vh) translateX(0);opacity:0}20%{opacity:.8}100%{transform:translateY(100vh) translateX(50px);opacity:0}}
@media(prefers-reduced-motion:reduce){.snow{display:none}}
.chero-body{width:100%;max-width:1240px;margin:0 auto}
.chero-badge{display:inline-block;background:var(--m-safran);color:var(--m-on-safran);padding:.45rem .85rem;border-radius:999px;font:700 .8rem/1 var(--m-body);margin-bottom:1rem}
.chero-title{font-size:clamp(3.2rem,12.5vw,9.5rem);margin:0 0 .9rem;color:var(--m-on-nuit)}
.chero-title em{font-style:normal;color:transparent;-webkit-text-stroke:2px var(--m-on-nuit)}
.chero-desc{max-width:52ch;font-size:1.02rem;line-height:1.65;color:color-mix(in srgb,var(--m-on-nuit) 85%,transparent);margin:0}
.chero-desc:empty{display:none}
.chero--compact{min-height:min(46svh,420px)}
@media(max-width:640px){.chero{min-height:62svh}.chero--compact{min-height:44svh}.chero-title{font-size:clamp(3rem,17vw,6rem)}.chero-title em{-webkit-text-stroke-width:1.5px}}

/* navigation latérale par chapitres */
.cdots{position:fixed;right:1.4rem;top:50%;transform:translateY(-50%);z-index:200;display:none;flex-direction:column;gap:1rem;opacity:0;transition:opacity .4s;pointer-events:none}
.cdots.show{opacity:1;pointer-events:auto}
@media(min-width:1100px){.cdots{display:flex}}
.cdots a{position:relative;width:8px;height:8px;border-radius:50%;background:color-mix(in srgb,var(--ink) 25%,transparent);transition:.25s}
.cdots a.active{background:var(--m-safran);transform:scale(1.7)}
.cdots a::before{content:attr(data-label);position:absolute;right:18px;top:50%;transform:translateY(-50%);font:600 .75rem/1 var(--m-body);color:var(--stone);white-space:nowrap;opacity:0;transition:.2s;pointer-events:none}
.cdots a:hover::before,.cdots a.active::before{opacity:1;color:var(--ink)}

/* ═════════ MANIFESTE ═════════ */
.manifest{position:relative;overflow:hidden;padding:clamp(3.5rem,8vw,6rem) var(--gut);text-align:center;margin-top:clamp(2.6rem,6vw,4.6rem);background:var(--m-tint-vert)}
.manifest-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.12;filter:grayscale(.6)}
.manifest-text{position:relative;font:italic 500 clamp(1.5rem,3.8vw,2.4rem)/1.4 var(--m-serif);max-width:820px;margin:0 auto;color:var(--ink)}
.manifest-text em{color:var(--m-acc-bissap)}
.manifest .eyebrow{position:relative}

/* ═════════ PIÈCE MAÎTRESSE ═════════ */
.piece{display:grid;grid-template-columns:1fr;gap:1.6rem;align-items:center}
@media(min-width:900px){.piece{grid-template-columns:1.05fr 1fr;gap:4rem}}
.piece-img{position:relative;border-radius:22px;overflow:hidden;aspect-ratio:4/5;background:var(--m-g-vert)}
.piece-img img{width:100%;height:100%;object-fit:cover;transition:transform 6s}
.piece:hover .piece-img img{transform:scale(1.04)}
.piece-img.is-out img{filter:grayscale(1) brightness(.6)}
.piece-badge{display:inline-block;background:var(--m-safran);color:var(--m-on-safran);padding:.45rem .85rem;border-radius:999px;font:700 .8rem/1 var(--m-body);margin-bottom:1rem;width:fit-content}
.piece-label{font:600 .85rem/1 var(--m-body);color:var(--stone);margin-bottom:.7rem}
.piece-name{font:800 clamp(2rem,5vw,3.4rem)/1 var(--m-display);font-variation-settings:"wdth" 90;letter-spacing:-.03em;color:var(--ink);margin:0 0 1.2rem}
.piece-desc{color:var(--stone);line-height:1.75;margin:0 0 1.8rem;max-width:46ch}
.piece-foot{display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap}
.piece-prix{font:800 clamp(1.7rem,3vw,2.2rem)/1 var(--m-display);color:var(--ink);letter-spacing:-.02em}
.piece-rare{display:block;font:700 .8rem/1 var(--m-body);color:var(--m-acc-bissap);margin-top:.4rem}

/* ═════════ MOSAÏQUE ═════════ */
.mosaic{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.mc-card{position:relative;overflow:hidden;border-radius:18px;aspect-ratio:3/4;background:var(--m-g-vert)}
.mc-link{position:absolute;inset:0;z-index:2}
.mc-card>img{width:100%;height:100%;object-fit:cover;transition:transform .8s,filter .5s}
.mc-card:hover>img{transform:scale(1.05)}
.mc-card.is-out>img{filter:grayscale(1) brightness(.55)}
.sepia .mc-card>img,.sepia .piece-img img,.sepia .look-collage img{filter:sepia(.28) saturate(.8)}
.sepia .mc-card:hover>img,.sepia .piece:hover .piece-img img{filter:none}
.mc-tag{position:absolute;top:.7rem;left:.7rem;z-index:3;background:var(--m-nuit);color:var(--m-on-nuit);border-radius:999px;padding:.35rem .7rem;font:700 .72rem/1 var(--m-body)}
.mc-tag.out{background:var(--m-bissap);color:var(--m-on-bissap)}
.mc-body{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:1rem;background:linear-gradient(to top,color-mix(in srgb,var(--m-nuit) 92%,transparent),transparent);display:flex;justify-content:space-between;align-items:flex-end;gap:.6rem;pointer-events:none;color:var(--m-on-nuit)}
.mc-body h3{font:700 .92rem/1.25 var(--m-body);margin:0 0 .2rem}
.mc-body small{display:block;font:600 .75rem/1.2 var(--m-body);color:var(--m-safran-2)}
.mc-prix{font:800 1.15rem/1 var(--m-display);color:var(--m-safran-2);white-space:nowrap}
.mc-add{position:absolute;top:.6rem;right:.6rem;z-index:4;width:38px;height:38px;border-radius:50%;background:var(--bg);color:var(--ink);border:1px solid var(--border);font-size:1.2rem;display:grid;place-items:center;transition:.2s}
.mc-add:hover{background:var(--m-safran);color:var(--m-on-safran);border-color:var(--m-safran)}
@media(min-width:900px){
  .mosaic{grid-template-columns:repeat(12,1fr);gap:12px}
  .mc-card:nth-child(6n+1){grid-column:span 5}.mc-card:nth-child(6n+2){grid-column:span 4}.mc-card:nth-child(6n+3){grid-column:span 3}
  .mc-card:nth-child(6n+4){grid-column:span 4}.mc-card:nth-child(6n+5){grid-column:span 5;aspect-ratio:16/9}.mc-card:nth-child(6n+6){grid-column:span 3}
}
@media(hover:hover) and (min-width:900px){.mc-body{transform:translateY(60%);transition:transform .4s}.mc-card:hover .mc-body{transform:none}}
@media(hover:hover){.mc-add{opacity:0;transform:translateY(-4px)}.mc-card:hover .mc-add{opacity:1;transform:none}}

/* ═════════ ENGAGEMENT ═════════ */
.eng{display:grid;grid-template-columns:1fr;gap:1rem}
@media(min-width:760px){.eng{grid-template-columns:1fr 1fr}}
.eng-card{border-radius:22px;padding:clamp(1.5rem,4vw,2.4rem);background:var(--m-tint-safran)}
.eng-card:nth-child(2){background:var(--m-tint-vert)}
.eng-card .eyebrow{--eb:var(--m-acc-bissap)}
.eng-card p{font:600 clamp(1.1rem,2vw,1.35rem)/1.55 var(--m-display);letter-spacing:-.01em;color:var(--ink);margin:0}
.eng-card p em{font-style:normal;color:var(--m-acc-bissap)}

/* ═════════ LOOKBOOK ═════════ */
.look{display:grid;grid-template-columns:1fr;border:1px solid var(--border);border-radius:22px;overflow:hidden;background:var(--card)}
@media(min-width:900px){.look{grid-template-columns:1fr 1fr}}
.look-collage{display:grid;min-height:380px;background:var(--m-g-vert);gap:4px}
.look-collage div{position:relative;overflow:hidden}
.look-collage img{width:100%;height:100%;object-fit:cover}
.look-content{padding:clamp(1.6rem,4vw,3rem);display:flex;flex-direction:column;justify-content:center}
.look-title{font:800 clamp(1.9rem,4vw,2.8rem)/1.02 var(--m-display);font-variation-settings:"wdth" 92;letter-spacing:-.03em;color:var(--ink);margin:0 0 1.4rem}
.look-items{display:flex;flex-direction:column;margin-bottom:1.6rem}
.look-item{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.95rem 0;border-bottom:1px solid var(--border);transition:padding .2s;color:var(--ink);text-decoration:none}
.look-item:hover{padding-left:.5rem}
.look-item span{font-weight:600}
.look-item strong{font:800 1.05rem/1 var(--m-display);color:var(--ink);white-space:nowrap}
.look-total{display:flex;justify-content:space-between;font:800 1.5rem/1 var(--m-display);margin-bottom:1.4rem;color:var(--ink)}
.look-content .btn-s{width:100%}

/* ═════════ BLOC SUIVANT / TEASING ═════════ */
.next,.tease{position:relative;overflow:hidden;border-radius:28px;text-align:center;padding:clamp(2.6rem,7vw,5rem) var(--gut);color:var(--m-on-indigo);background:linear-gradient(145deg,var(--m-indigo),color-mix(in srgb,var(--m-indigo) 50%,var(--m-vert)) 55%,var(--m-vert))}
.next::before,.tease::before{content:'';position:absolute;inset:0;background:radial-gradient(55% 60% at 90% 0%,color-mix(in srgb,var(--m-indigo-2) 40%,transparent),transparent 65%);pointer-events:none}
.next>*,.tease>*{position:relative}
.next .eyebrow,.tease .eyebrow{--eb:var(--m-safran-2)}
.next h2{font:800 clamp(2.2rem,6vw,4rem)/.98 var(--m-display);font-variation-settings:"wdth" 90;letter-spacing:-.035em;margin:0 auto 1rem;max-width:16ch;color:var(--m-on-indigo)}
.next h2 i,.tease .t-big i{color:var(--m-safran-2)}
.tease .t-big{color:var(--m-on-indigo)}
.next p,.tease-text{color:color-mix(in srgb,var(--m-on-indigo) 86%,transparent);max-width:46ch;margin:0 auto 1.8rem;line-height:1.7}
.chrono{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;max-width:420px;margin:0 auto 1.8rem}
.chrono-unit{border:1px solid color-mix(in srgb,var(--m-safran-2) 60%,transparent);border-radius:14px;padding:.8rem .3rem;background:color-mix(in srgb,var(--m-nuit) 40%,transparent)}
.chrono-val{display:block;font:800 clamp(1.7rem,5vw,2.6rem)/1 var(--m-display);color:var(--m-safran-2)}
.chrono-lbl{display:block;font:600 .7rem/1 var(--m-body);color:color-mix(in srgb,var(--m-on-indigo) 75%,transparent);margin-top:.4rem}
.empty-note{text-align:center;color:var(--stone);padding:4rem 1rem}
.after{padding-bottom:clamp(3rem,7vw,5rem)}

/* ═════════ LISTE DES COLLECTIONS (collections.js) ═════════ */
.dcol-list{display:flex;flex-direction:column;gap:1.1rem}
.dcol{position:relative;border-radius:22px;padding:clamp(1.4rem,4vw,2.2rem);overflow:hidden}
.dcol-tag{display:inline-block;padding:.4rem .75rem;border-radius:999px;font:700 .78rem/1 var(--m-body);margin-bottom:.9rem;background:var(--m-safran);color:var(--m-on-safran)}
.dcol-tag--live{background:var(--m-vert);color:var(--m-on-vert)}
.dcol-tag--past{background:var(--bg2);color:var(--stone);border:1px solid var(--border)}
.dcol-name{font:800 clamp(1.8rem,4vw,2.8rem)/1.02 var(--m-display);font-variation-settings:"wdth" 90;letter-spacing:-.03em;color:var(--ink);margin:0 0 .6rem}
.dcol-desc{font-size:.96rem;color:var(--stone);line-height:1.7;margin:0 0 1.2rem;max-width:56ch}
.dcol-live{background:var(--card);border:1px solid var(--border)}
.dcol-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1.4rem;flex-wrap:wrap;margin-bottom:1.2rem}
.dcol-arts{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.8rem}
.dcol-art{display:flex;align-items:center;gap:.8rem;padding:.7rem;border-radius:16px;background:var(--bg2);text-decoration:none;color:inherit;transition:transform .2s}
.dcol-art:hover{transform:translateY(-3px)}
.dcol-art-img{width:62px;height:62px;border-radius:12px;background:var(--m-g-vert) center/cover no-repeat;flex-shrink:0}
.dcol-art-name{font:600 .9rem/1.3 var(--m-body);color:var(--ink);margin-bottom:.2rem}
.dcol-art-prix{font:800 1rem/1 var(--m-display);color:var(--ink)}
.dcol-art-stock{display:block;font:700 .75rem/1 var(--m-body);margin-top:.3rem}
.dcol-art-stock.low{color:var(--m-acc-bissap)}.dcol-art-stock.ok{color:var(--m-acc-vert)}
.dcol-note{font:600 .82rem/1 var(--m-body);color:var(--stone);margin:1.1rem 0 0}
.dcol-soon{background:var(--m-tint-indigo);display:grid;grid-template-columns:1fr 1.4fr;gap:2rem;align-items:center}
.dcol-teaser{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
.dcol-teaser div{aspect-ratio:3/4;border-radius:14px;background:var(--m-g-indigo) center/cover no-repeat;filter:blur(4px) brightness(.55);transition:filter .4s}
.dcol-soon:hover .dcol-teaser div{filter:blur(2px) brightness(.7)}
.dcol-cd{display:grid;grid-template-columns:repeat(4,minmax(0,64px));gap:.5rem;margin:.4rem 0 1.3rem}
.dcol-cd div{border:1px solid var(--border);border-radius:12px;padding:.55rem .2rem;text-align:center;background:var(--bg)}
.dcol-cd b{display:block;font:800 1.5rem/1 var(--m-display);color:var(--ink)}
.dcol-cd small{display:block;font:600 .65rem/1 var(--m-body);color:var(--stone);margin-top:.3rem}
.dcol-past{background:var(--bg2);padding:1.2rem 1.5rem}
.dcol-past-row{display:flex;justify-content:space-between;align-items:center;gap:1.4rem;flex-wrap:wrap}
.dcol-past-name{font:800 1.3rem/1.1 var(--m-display);color:var(--stone);margin:0}
.dcol-past-stock{font-size:.88rem;color:var(--stone);margin:.25rem 0 0}
@media(max-width:700px){.dcol-soon{grid-template-columns:1fr}}

/* ═════════ PANIER COULISSANT ═════════ */
.drawer-overlay{position:fixed;inset:0;background:color-mix(in srgb,var(--m-nuit) 60%,transparent);z-index:9999;opacity:0;pointer-events:none;transition:opacity .3s}
.drawer-overlay.open{opacity:1;pointer-events:auto}
.cart-drawer{position:fixed;bottom:0;left:0;right:0;height:85vh;background:var(--bg);border-top:1px solid var(--border);border-radius:24px 24px 0 0;transform:translateY(100%);transition:transform .4s cubic-bezier(.4,0,.2,1);z-index:10000;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom)}
.cart-drawer.open{transform:none}
.cart-handle{width:44px;height:5px;background:var(--border);border-radius:3px;margin:10px auto 0;flex-shrink:0}
.drawer-head{padding:1rem 1.4rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.drawer-head h3{font-size:1.6rem;margin:0;color:var(--ink)}
.drawer-close{background:none;border:1px solid var(--border);border-radius:50%;color:var(--ink);width:38px;height:38px;font-size:1.3rem;cursor:pointer}
.drawer-close:hover{background:var(--m-safran);color:var(--m-on-safran);border-color:var(--m-safran)}
.cart-drawer-inner{overflow-y:auto;flex:1;padding:1.2rem;-webkit-overflow-scrolling:touch}
.drawer-item{display:flex;gap:1rem;margin-bottom:1.3rem;padding-bottom:1.3rem;border-bottom:1px solid var(--border);align-items:flex-start}
.drawer-item img,.drawer-ph{width:70px;height:90px;object-fit:cover;border-radius:12px;flex-shrink:0}
.drawer-ph{background:var(--m-g-vert)}
.drawer-item-info{flex:1;display:flex;flex-direction:column;min-width:0}
.drawer-item-info h4{font:600 .9rem/1.3 var(--m-body);margin:0 0 .3rem;color:var(--ink)}
.drawer-item-info p{font:800 1.15rem/1 var(--m-display);color:var(--ink);margin:0}
.drawer-qty-controls{display:flex;align-items:center;gap:8px;margin-top:10px}
.qty-btn{background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--ink);width:30px;height:30px;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer}
.qty-btn:hover:not(:disabled){background:var(--m-safran);color:var(--m-on-safran);border-color:var(--m-safran)}
.qty-btn:disabled{opacity:.35;cursor:not-allowed}
.qty-val{font:700 .9rem/1 var(--m-body);color:var(--ink);min-width:22px;text-align:center}
.remove-btn{background:none;border:none;color:var(--red);font:600 .75rem/1 var(--m-body);cursor:pointer;margin-left:auto;padding:4px}
.remove-btn:hover{text-decoration:underline}
.drawer-footer{padding:1.2rem;border-top:1px solid var(--border);background:var(--bg)}
.drawer-total{display:flex;justify-content:space-between;margin-bottom:1.2rem;font:800 1.5rem/1 var(--m-display);color:var(--ink)}
.drawer-btn{display:flex;align-items:center;justify-content:center;width:100%;min-height:50px;padding:1rem;background:var(--m-safran);color:var(--m-on-safran);border-radius:12px;text-decoration:none;font:700 .95rem/1 var(--m-body)}
.drawer-empty{text-align:center;color:var(--stone);padding:3rem 1rem}
@media(min-width:768px){.cart-drawer{top:0;bottom:auto;left:auto;right:0;width:420px;height:100vh;border-top:none;border-left:1px solid var(--border);border-radius:0;transform:translateX(100%)}.cart-drawer.open{transform:none}.cart-handle{display:none}}

/* apparition douce (le contenu reste visible si le JS échoue) */
.rv-ready .rv{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.rv-ready .rv.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rv-ready .rv{opacity:1;transform:none;transition:none}}
